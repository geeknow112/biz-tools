# biz-tools config example
# Copy to config.yaml and edit

platforms:
  zenn:
    repo: C:\Users\youre\Documents\git_repo\zenn-devex12
  qiita:
    repo: C:\Users\youre\Documents\git_repo\qiita-content
  note:
    repo: C:\Users\youre\Documents\git_repo\note-content
  wordpress:
    repo: C:\Users\youre\Documents\git_repo\corporate-content
    url: https://trident-capital-symbiosis.com
    username: biz-tools
    app_password: xxxx xxxx xxxx xxxx xxxx xxxx

# Used by `biz-tools crawl` (SerpApi — Google search results via API, not scraping)
# Get a key: https://serpapi.com (free tier: 250 searches/month)
crawl:
  serpapi_key: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used by `biz-tools outreach` when drafting/submitting messages.
# message_template is a Go text/template string; leave unset to use the
# built-in default. Available fields: .URL .FindingsList .SenderName
# .SenderCompany .SenderEmail
outreach:
  sender_name: 山田 太郎
  sender_company: Trident Capital Symbiosis 合同会社
  sender_email: info@trident-capital-symbiosis.com
  message_template: ""
